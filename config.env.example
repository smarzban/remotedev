# =============================================================================
# remotedev-bootstrap configuration
# Copy this file to `config.env` and edit. config.env is git-ignored.
# Every value can also be supplied as an environment variable when running.
# =============================================================================

# --- Identity --------------------------------------------------------------
# The non-root sudo user to create / harden around.
TARGET_USER="deploy"

# Password for TARGET_USER. This posture requires a password for sudo, so the user
# needs one (SSH login stays key-only; this password is only for sudo/console).
# RECOMMENDED: leave empty — the script prompts interactively (TTY required).
# If set, setup.sh blanks it in config.env once the password is applied.
SUDO_PASSWORD=""

# SSH public key(s) to authorize for TARGET_USER. One full key per line.
# If empty, the script keeps any existing authorized_keys (and refuses to
# disable password auth if the user would have NO key — anti-lockout guard).
SSH_AUTHORIZED_KEYS="
"

# --- SSH hardening ---------------------------------------------------------
# Non-standard SSH port (example below — choose your own). sshd still binds 0.0.0.0:PORT,
# but the firewall keeps it reachable only over Tailscale (see below).
SSH_PORT="2202"

# --- Tailscale -------------------------------------------------------------
# Auth key for the tailnet. Generate at:
#   https://login.tailscale.com/admin/settings/keys
# STRONGLY RECOMMENDED: a SINGLE-USE, pre-authorized, TAGGED (e.g. tag:remotedev),
# NON-EPHEMERAL key.
#   - single-use: a captured key is already spent, can't enroll a rogue node.
#   - tagged: disables node-key expiry (untagged keys expire ~180 days, which
#     locks you out of a sealed box) and lets a tailnet ACL restrict access.
#   - NOT ephemeral: ephemeral nodes are deleted after going offline — on a
#     sealed box that means lockout.
# Passed via a 0600 tmpfs file (never argv) and blanked in config.env after join.
# REQUIRED unless ALLOW_PUBLIC_SSH=true.
TS_AUTHKEY=""

# Tailscale machine name (defaults to the system hostname if empty).
TS_HOSTNAME=""

# --- Firewall posture ------------------------------------------------------
# false (default, sealed): the public interface is fully sealed —
#   inbound is allowed ONLY on tailscale0 (v4 AND v6). SSH only via Tailscale.
# true: also opens SSH_PORT on the public interface (fallback / no-VPN setups).
ALLOW_PUBLIC_SSH="false"

# --- Hardening toggles -----------------------------------------------------
# SSH port/agent/tunnel forwarding. Default "false" = disabled (a compromised
# key can't pivot into the tailnet/localhost). Set "true" only if you need it.
ALLOW_SSH_FORWARDING="false"

# Lock the root account password (SSH root login is disabled regardless). This
# closes the serial/rescue-console password vector. Only applied once TARGET_USER
# has a working SSH key. Set "false" if your provider's console needs root login.
LOCK_ROOT_PASSWORD="true"

# Opt-in detection layer: install auditd with a low-noise auth/identity ruleset.
# Off by default (minimal posture). Set "true" to enable.
INSTALL_AUDIT="false"

# unattended-upgrades auto-reboot so patched kernels/libc actually run.
AUTO_REBOOT="true"
AUTO_REBOOT_TIME="04:00"          # box-local time

# --- Dev tooling (tooling.sh only — NOT used by setup.sh) ------------------
# tooling.sh is the separate dev-host layer, run AFTER setup.sh has hardened the
# box. These toggle which tools it installs. The `upgrade` step (full apt
# dist-upgrade) always runs. All default to "true"; set "false" to skip.
INSTALL_DOCKER="true"     # Docker CE (signed apt repo) + add TARGET_USER to docker group
INSTALL_BREW="true"       # Homebrew (Linuxbrew), installed as TARGET_USER
INSTALL_UV="true"         # Astral uv, installed as TARGET_USER
INSTALL_PYTHON="true"     # system Python base (python3 + venv + pip + dev)
INSTALL_NODE="true"       # Node.js + npm from NodeSource (signed apt repo)
NODE_MAJOR="24"           # Node major to install (24 = current LTS)

# --- Hetzner provisioning (provision-hetzner.sh only) ----------------------
# Used by the local provision-hetzner.sh helper to CREATE the box (it does not
# harden — that's setup.sh). Requires the `hcloud` CLI, authenticated.
HCLOUD_SERVER_NAME="remotedev"     # also becomes the hostname / Tailscale name (TS_HOSTNAME)
HCLOUD_SERVER_TYPE="cx23"          # ARM cax11/cax21 if in stock; else cx23/cx33/cpx*
HCLOUD_LOCATION="hel1"             # fsn1 | nbg1 | hel1 | ash | hil | sin
HCLOUD_IMAGE="ubuntu-24.04"        # 24.04 => Python 3.12 baseline
HCLOUD_SSH_KEY=""                  # REQUIRED: name of a key already in your hcloud account
                                   #   (see 'hcloud ssh-key list'); used for initial root login
HCLOUD_FIREWALL="true"             # Hetzner Cloud Firewall: SSH only from HCLOUD_FW_SOURCE during bootstrap
HCLOUD_FW_SOURCE="auto"            # "auto" = your current public IPv4, or e.g. "203.0.113.7/32"
